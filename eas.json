{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MOBILE_API_URL": "https://api-mobile.chatboxai.co.in"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MOBILE_API_URL": "https://api-mobile.chatboxai.co.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

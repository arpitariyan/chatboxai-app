# ============================================================================
# ChatBox AI Mobile APK - Environment Configuration Template
# Copy this file to .env and populate with your own credentials
# ============================================================================

# Firebase Authentication Credentials
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# OAuth Client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_microsoft_client_id

# Appwrite Database Credentials
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
EXPO_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
EXPO_PUBLIC_APPWRITE_LIBRARY_COLLECTION_ID=library
EXPO_PUBLIC_APPWRITE_CHATS_COLLECTION_ID=chats
EXPO_PUBLIC_APPWRITE_IMAGE_GENERATION_COLLECTION_ID=image_generation
EXPO_PUBLIC_APPWRITE_WEBSITE_PROJECTS_COLLECTION_ID=website_projects
EXPO_PUBLIC_APPWRITE_MFA_OTPS_COLLECTION_ID=mfa_otps
EXPO_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=your_storage_bucket_id

# Backend & Resend Credentials
EXPO_PUBLIC_WEB_API_URL=https://chatboxai.co.in
EXPO_PUBLIC_MOBILE_API_URL=https://api-mobile.chatboxai.co.in
EXPO_PUBLIC_RESEND_API_KEY=your_resend_api_key

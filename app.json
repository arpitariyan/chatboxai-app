{
  "expo": {
    "name": "Chatbox Ai",
    "slug": "Chatboxai_APK",
    "scheme": "chatboxai",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/Main-logo.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chatboxai.app",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ChatBox AI to save generated images to your photo gallery.",
          "savePhotosPermission": "Allow ChatBox AI to save generated images to your photo gallery."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ChatBox AI to record your voice for speech-to-text."
        }
      ],
      "expo-video",
      "expo-secure-store",
      "./plugins/withSecurityHardening"
    ]
  }
}
